# Azure Cloud Data Engineering Capstone - Environment Variables Example
# Copy this file to .env and populate with your own environment values.
# NEVER commit .env to version control.

# Azure Storage Configuration
AZURE_STORAGE_ACCOUNT=your_storage_account_name
AZURE_CONTAINER_NAME=bronze

# Azure Databricks Configuration
# When using Azure CLI auth (az login), DATABRICKS_TOKEN is dynamically acquired via DefaultAzureCredential.
# If using a Personal Access Token directly:
DATABRICKS_SERVER_HOSTNAME=adb-your-workspace-id.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-sql-warehouse-id
DATABRICKS_CATALOG=your_catalog_name
DATABRICKS_SCHEMA=default
# DATABRICKS_TOKEN=dapi_placeholder_only_do_not_commit_real_tokens

# Azure Resource Group & Factory
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_DATA_FACTORY_NAME=your-adf-name
